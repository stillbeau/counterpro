{
  "manifest_version": 3,
  "name": "CounterPro Inventory Sync",
  "version": "1.1.0",
  "description": "Reads the Moraware slab inventory views once a day with your signed-in session and sends them to CounterPro.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://*.moraware.net/*", "https://api.github.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "CounterPro Inventory Sync", "default_popup": "popup.html" },
  "options_page": "options.html"
}
